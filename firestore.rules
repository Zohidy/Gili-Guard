rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: lost_and_found
    // Fields:
    //   - type: string ("lost" | "found")
    //   - title: string (1-100 chars)
    //   - description: string (1-1000 chars)
    //   - location: string (1-200 chars)
    //   - contact: string (1-200 chars)
    //   - status: string ("active" | "resolved")
    //   - uid: string
    //   - createdAt: timestamp
    //
    // Collection: sos_alerts
    // Fields:
    //   - uid: string | null
    //   - userName: string
    //   - coords: string
    //   - timestamp: timestamp
    //   - status: string ("active" | "resolved")
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "zohidydy@gmail.com" && 
        request.auth.token.email_verified == true
      );
    }

    function isValidItem(data) {
      return data.type in ['lost', 'found'] &&
             data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.description is string && data.description.size() > 0 && data.description.size() < 1000 &&
             data.location is string && data.location.size() > 0 && data.location.size() < 200 &&
             data.contact is string && data.contact.size() > 0 && data.contact.size() < 200 &&
             data.status in ['active', 'resolved'] &&
             data.uid is string &&
             data.createdAt is timestamp;
    }

    function isValidSOSAlert(data) {
      return data.userName is string && data.userName.size() > 0 &&
             data.coords is string && data.coords.size() > 0 &&
             data.status in ['active', 'resolved'] &&
             data.timestamp is timestamp;
    }

    match /lost_and_found/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                      isValidItem(request.resource.data) && 
                      request.resource.data.uid == request.auth.uid;
      allow update: if (isOwner(resource.data.uid) || isAdmin()) && 
                      isValidItem(request.resource.data);
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    match /sos_alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isValidSOSAlert(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
